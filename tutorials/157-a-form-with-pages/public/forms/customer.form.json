            "city": { "col": 11, "row": 3, "colSpan": 18, "rowSpan": 2 },
            "postcodeLabel": { "col": 29, "row": 3, "colSpan": 6, "rowSpan": 2, "justify": "end" },
            "postcode": { "col": 35, "row": 3, "colSpan": 8, "rowSpan": 2 },
            "noteLabel": { "col": 1, "row": 1, "colSpan": 10, "rowSpan": 2, "justify": "end" },
            "note": { "col": 11, "row": 1, "colSpan": 32, "rowSpan": 6, "align": "stretch" },
            "newsletter": { "col": 11, "row": 7, "colSpan": 32, "rowSpan": 2 }
          }
        }
      ]
    }
  ]
}
