{
    "tabWidth": 4,
    "useTabs": false,
    "singleQuote": true,
    "semi": true,
    "bracketSpacing": false,
    "arrowParens": "avoid",
    "trailingComma": "es5",
    "bracketSameLine": true,
    "printWidth": 255,
    "endOfLine": "lf",
    "overrides": [
        {
            "files": "src/app/playground/playground-help/sign-in/sample/*.ts",
            "excludeFiles": "**/*.spec.ts",
            "options": {
                "printWidth": 100
            }
        }
    ]
}
